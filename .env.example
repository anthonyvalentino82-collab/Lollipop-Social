# Copy this file to .env for running on your own computer. On Render, enter these
# in the dashboard instead (Environment tab). Never share or commit real keys.

# Password that protects your app. Pick something long.
APP_PASSWORD=

# Captions (speech-to-text). OpenAI Whisper — about $0.006 per minute of video.
# Leave empty to use the free built-in transcriber (slower, needs more memory).
OPENAI_API_KEY=

# Auto B-roll stock footage — free. Pixabay (pixabay.com/api/docs) and/or Pexels.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Optional: Claude picks smarter B-roll moments and search words (~1-2 cents per video).
ANTHROPIC_API_KEY=

# Advanced (usually leave alone)
# TRANSCRIBE_PROVIDER=openai   # or "local"
# LOCAL_WHISPER_MODEL=base.en  # local model size: tiny.en, base.en, small.en
# DATA_DIR=./data

# Private key that lets Claude read "Report a problem" reports (technical details only).
DEBUG_KEY=
